# Server-side values for the Vercel API function.
# Add COOKIEBOT_SITES_TOKEN in Vercel Project Settings > Environment Variables.
# Never prefix the token with VITE_ and never put the real token in Git.
COOKIEBOT_API_URL=https://cookiebot-th.surijenafallon0.chatgpt.site
COOKIEBOT_SITES_TOKEN=put-your-project-access-token-here

# Existing backend remains available for routes not yet moved to the old system.
RENDER_API_URL=https://ibot-cookierun-classic.onrender.com

# Optional local-development frontend override.
VITE_API_URL=

# Upstash for Redis is connected from the Vercel Storage page. Depending on
# the selected prefix, Vercel creates STORAGE_* or KV_* variables automatically.
STORAGE_REST_API_URL=
STORAGE_REST_API_TOKEN=

# Dedicated Redis for sessions, portal settings, access codes and LINE-issued
# codes. Keeping this separate prevents farm-history traffic from exhausting
# the operational database quota.
SESSION_REDIS_REST_URL=
SESSION_REDIS_REST_TOKEN=

# LINE OA and Slip2Go server-side secrets. Never prefix these with VITE_.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
SLIP2GO_API_SECRET=
SLIP2GO_API_URL=https://connect.slip2go.com/api/verify-slip/qr-image/info

# Receiver validation used when the website verifies a LINE slip directly.
PROMPTPAY_NUMBER=
SLIP_RECEIVER_NAME=
